# Environment Variables for Jarvis Kanban

# Path to tasks.json file
# This can be a local path or a cloud storage path (Google Drive, Dropbox, etc.)
#
# Examples:
#   Local:       TASKS_PATH=/Users/yourname/Documents/kanban/tasks.json
#   Google Drive: TASKS_PATH=/Users/yourname/Library/CloudStorage/GoogleDrive-you@gmail.com/My Drive/Jarvis/kanban/tasks.json
#   Dropbox:     TASKS_PATH=/Users/yourname/Dropbox/kanban/tasks.json
#
# Default (if not set): ~/kanban/tasks.json
TASKS_PATH=/path/to/your/tasks.json

# Server port (optional)
# Default: 8888
# PORT=8888
